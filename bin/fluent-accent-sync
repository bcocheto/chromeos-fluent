#!/usr/bin/env python3
"""Renderiza o tema ChromeOS-Fluent com a cor de destaque do sistema (GNOME)."""
import subprocess, sys
from pathlib import Path

T = Path.home() / ".themes" / "ChromeOS-Fluent"
FILES = ["gnome-shell/gnome-shell.css", "gtk-3.0/gtk.css", "gtk-3.0/gtk-dark.css",
         "gtk-4.0/gtk.css", "gtk-4.0/gtk-dark.css",
         "gnome-shell/assets/toggle-on.svg", "gnome-shell/assets/checkbox.svg", "gnome-shell/assets/more-results.svg"]
# nome: (fundo, claro p/ texto e foco, texto sobre fundo) - paleta do GNOME (modo escuro)
ACC = {
 "blue":   ("#2a76d4", "#78aeed", "#ffffff"),
 "teal":   ("#1b7a8c", "#5bc8af", "#ffffff"),
 "green":  ("#2f7d3c", "#8ff0a4", "#ffffff"),
 "yellow": ("#c88800", "#f8e45c", "#1e1e1e"),
 "orange": ("#c24800", "#ffa348", "#ffffff"),
 "red":    ("#d02438", "#ff7b63", "#ffffff"),
 "pink":   ("#b8467f", "#ed9ec6", "#ffffff"),
 "purple": ("#9141ac", "#dc8add", "#ffffff"),
 "slate":  ("#5b6f82", "#a5b4c3", "#ffffff"),
 "brown":  ("#865e3c", "#d1a37a", "#ffffff"),
}
def rgb(h): h = h.lstrip("#"); return ", ".join(str(int(h[i:i+2], 16)) for i in (0, 2, 4))

name = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "accent-color"],
                      capture_output=True, text=True).stdout.strip().strip("'") or "blue"
bg, light, fg = ACC.get(name, ACC["blue"])
sub = {"@ACC@": bg, "@ACCL@": light, "@ACCFG@": fg, "@ACC_RGB@": rgb(bg), "@ACCL_RGB@": rgb(light)}
changed_shell = False
for f in FILES:
    tpl = T / (f + ".tpl")
    if not tpl.exists(): continue
    s = tpl.read_text()
    for k, v in sub.items(): s = s.replace(k, v)
    out = T / f
    if not out.exists() or out.read_text() != s:
        out.write_text(s)
        changed_shell |= f.startswith("gnome-shell")
if changed_shell and "--no-reload" not in sys.argv:
    k = "/org/gnome/shell/extensions/user-theme/name"
    subprocess.run(["dconf", "write", k, "''"]); subprocess.run(["dconf", "write", k, "'ChromeOS-Fluent'"])
A="/org/gnome/shell/extensions/arcmenu/"
for k,v in {"menu-background-color":"rgba(30,32,40,0.88)","menu-border-color":"rgba(255,255,255,0.09)",
            "menu-item-active-bg-color":"rgba(%s,0.30)"%rgb(bg).replace(" ","")}.items():
    subprocess.run(["dconf","write",A+k,"'%s'"%v])
# pastas do tema de ícones seguem o destaque (tema derivado, herda o Tela-circle)
import shutil, re as _re
SRC = Path.home()/".local/share/icons/Tela-circle"; DST = Path.home()/".local/share/icons/Tela-circle-accent"
def _mix(a, b):
    return "#%02x%02x%02x" % tuple((int(a[i:i+2],16)+int(b[i:i+2],16))//2 for i in (1,3,5))
folder = _mix(bg, light)
stamp = DST/".accent"
if SRC.exists() and not (stamp.exists() and stamp.read_text() == folder):
    DST.mkdir(exist_ok=True)
    idx = (SRC/"index.theme").read_text()
    idx = _re.sub(r"^Name=.*$", "Name=Tela circle accent", idx, flags=_re.M)
    idx = _re.sub(r"^Inherits=.*$", "Inherits=Tela-circle,hicolor,Adwaita,breeze", idx, flags=_re.M)
    (DST/"index.theme").write_text(idx)
    for d in SRC.iterdir():
        pl = d/"places"
        if not pl.is_dir(): continue
        out = DST/d.name/"places"
        if out.exists(): shutil.rmtree(out)
        shutil.copytree(pl, out, symlinks=True)
        for f in out.glob("*.svg"):
            if f.is_symlink(): continue
            t = f.read_text()
            if "#5294e2" in t: f.write_text(t.replace("#5294e2", folder))
    stamp.write_text(folder)
    subprocess.run(["gtk-update-icon-cache", "-f", "-t", str(DST)], capture_output=True)
    subprocess.run(["gsettings","set","org.gnome.desktop.interface","icon-theme","Tela-circle-accent"])
print("accent:", name, bg)
